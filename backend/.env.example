# Port the API listens on
PORT=3000

# PostgreSQL connection string (Neon / Supabase / Render / local).
# Leave empty to use the embedded PGlite database stored in ./.data (no install needed).
DATABASE_URL=

# Comma-separated list of allowed frontend origins. Empty = allow all (fine for local dev).
CORS_ORIGIN=

# The single time zone the host publishes slots in.
APP_TIMEZONE=Europe/London

# Shown in the UI and used in the AI confirmation message.
HOST_NAME=Alex, AI Coach

# Free key from https://aistudio.google.com/apikey — leave empty to use a template message.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Seed a few demo slots when the database is empty.
SEED_DEMO=true
