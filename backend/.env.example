# Port the API listens on
PORT=3000

# PostgreSQL connection string (Neon / Supabase / Render / local).
# Leave empty to use the embedded PGlite database stored in ./.data (no install needed).
DATABASE_URL=

# Comma-separated list of allowed frontend origins. Empty = allow all (fine for local dev).
CORS_ORIGIN=

# The single time zone the host publishes slots in.
APP_TIMEZONE=Europe/London

# Shown in the UI and used in the AI confirmation message.
HOST_NAME=Alex, AI Coach

# Free key from https://aistudio.google.com/apikey — leave empty to use a template message.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Calendar clash detection (optional): slots overlapping the host's events become unavailable.
# GOOGLE_CALENDAR_ID is usually the host's Gmail address. The key is a service-account JSON key
# (paste the JSON, or base64 of it). Share the calendar with that service account as "Make changes to events"
# so bookings are added to it, or "See only free/busy" for clash detection only.
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional: OAuth "Web application" client so the host can click "Connect Google" on the dashboard.
# Events are then created as the host and Google emails each new guest a calendar invite.
# Authorised redirect URI: <PUBLIC_URL>/api/host/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Public base URL (Render sets RENDER_EXTERNAL_URL automatically, so this is only needed elsewhere).
PUBLIC_URL=

# Seed a few demo slots when the database is empty.
SEED_DEMO=true
